{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wechat_publisher_list_receipt.v1",
  "title": "WeChat publisher-list progress and dedup receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "request_sha256",
    "publisher_results",
    "query_results",
    "unique_items",
    "dedup_summary",
    "usage_boundary"
  ],
  "properties": {
    "schema": {"const": "wechat_publisher_list_receipt.v1"},
    "task_id": {"type": "string", "minLength": 1},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "publisher_results": {"type": "array", "minItems": 1},
    "query_results": {"type": "array"},
    "unique_items": {"type": "array"},
    "dedup_summary": {"type": "object"},
    "usage_boundary": {"type": "string", "minLength": 1}
  }
}
