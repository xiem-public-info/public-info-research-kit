{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "d292_research_orchestration.v1",
  "title": "Portable D-292 research orchestration contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "aggregate_surfaces",
    "competitor_lifecycle_precheck",
    "complete_event_count_policy",
    "first_return",
    "official_expression_policy",
    "thread_policy"
  ],
  "properties": {
    "schema": {
      "const": "d292_research_orchestration.v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "aggregate_surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform",
          "aggregate_surface_id",
          "authorization_status",
          "aggregate_output_role",
          "aggregate_answer_evidence_allowed",
          "ordinary_original_source_surfaces"
        ],
        "properties": {
          "platform": {
            "enum": [
              "wechat",
              "xhs"
            ]
          },
          "aggregate_surface_id": {
            "enum": [
              "wechat_ai_search",
              "xhs_ask_diandian"
            ]
          },
          "authorization_status": {
            "enum": [
              "authorized",
              "not_authorized",
              "unresolved"
            ]
          },
          "aggregate_output_role": {
            "const": "ai_aggregate_clue"
          },
          "aggregate_answer_evidence_allowed": {
            "const": false
          },
          "ordinary_original_source_surfaces": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "competitor_lifecycle_precheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "applies": {
          "type": "boolean"
        },
        "complete_before_deep_retrieval": {
          "const": true
        },
        "downstream_decides_final_competitor_role": {
          "const": true
        },
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "object_id",
              "identity_closed",
              "current_new_home_supply_checked",
              "recent_six_month_content_checked",
              "launch_and_actual_product_checked",
              "delivery_date_checked",
              "months_to_delivery",
              "applicable_product_scope",
              "recommended_role"
            ],
            "properties": {
              "object_id": {
                "type": "string",
                "minLength": 1
              },
              "identity_closed": {
                "const": true
              },
              "current_new_home_supply_checked": {
                "const": true
              },
              "recent_six_month_content_checked": {
                "const": true
              },
              "launch_and_actual_product_checked": {
                "const": true
              },
              "delivery_date_checked": {
                "const": true
              },
              "months_to_delivery": {
                "oneOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "const": "unknown"
                  }
                ]
              },
              "applicable_product_scope": {
                "enum": [
                  "whole_project",
                  "partial_tier",
                  "unknown"
                ]
              },
              "recommended_role": {
                "enum": [
                  "deep_search",
                  "partial_tier",
                  "tail_end_reference",
                  "exclude_candidate",
                  "qualification_pending"
                ]
              },
              "role_evidence_refs": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "target_inventory": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sales_stage": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "applies": {
                "const": false
              }
            },
            "required": [
              "applies"
            ]
          },
          "then": {},
          "else": {
            "required": [
              "applies",
              "complete_before_deep_retrieval",
              "downstream_decides_final_competitor_role",
              "objects"
            ]
          }
        }
      ]
    },
    "complete_event_count_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "minimum_per_project": {
          "type": "integer",
          "minimum": 0
        },
        "target_per_project": {
          "type": "integer",
          "minimum": 0
        },
        "target_is_maximum": {
          "const": false
        },
        "preserve_qualified_excess": {
          "const": true
        },
        "project_event_affiliation_count": {
          "type": "integer",
          "minimum": 0
        },
        "unique_household_journey_count": {
          "type": "integer",
          "minimum": 0
        },
        "global_dedup_unit": {
          "const": "independent_person_or_household_journey"
        },
        "applies": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "applies": {
                "const": false
              }
            },
            "required": [
              "applies"
            ]
          },
          "then": {},
          "else": {
            "required": [
              "minimum_per_project",
              "target_per_project",
              "target_is_maximum",
              "preserve_qualified_excess",
              "project_event_affiliation_count",
              "unique_household_journey_count",
              "global_dedup_unit"
            ]
          }
        }
      ]
    },
    "first_return": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_core_support_status",
        "merged_increment_proposal"
      ],
      "properties": {
        "project_fact_support_assessed": {
          "const": true
        },
        "competitor_relation_support_assessed": {
          "const": true
        },
        "customer_choice_support_assessed": {
          "const": true
        },
        "counterexample_support_assessed": {
          "const": true
        },
        "semantic_core_support_status": {
          "enum": [
            "supported",
            "partial",
            "unsupported",
            "not_applicable"
          ]
        },
        "merged_increment_proposal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "proposed",
            "downstream_authorization_required",
            "execution_authorized"
          ],
          "properties": {
            "proposed": {
              "type": "boolean"
            },
            "downstream_authorization_required": {
              "type": "boolean"
            },
            "execution_authorized": {
              "type": "boolean"
            }
          }
        },
        "residential_semantic_core_applies": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "residential_semantic_core_applies": {
                "const": false
              }
            },
            "required": [
              "residential_semantic_core_applies"
            ]
          },
          "then": {
            "properties": {
              "semantic_core_support_status": {
                "const": "not_applicable"
              }
            }
          },
          "else": {
            "required": [
              "project_fact_support_assessed",
              "competitor_relation_support_assessed",
              "customer_choice_support_assessed",
              "counterexample_support_assessed",
              "semantic_core_support_status",
              "merged_increment_proposal"
            ],
            "properties": {
              "semantic_core_support_status": {
                "enum": [
                  "supported",
                  "partial",
                  "unsupported"
                ]
              }
            }
          }
        }
      ]
    },
    "official_expression_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "core_view_required": {
          "const": true
        },
        "necessary_original_wording_required": {
          "const": true
        },
        "source_locator_required": {
          "const": true
        },
        "applies": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "applies": {
                "const": false
              }
            },
            "required": [
              "applies"
            ]
          },
          "then": {},
          "else": {
            "required": [
              "core_view_required",
              "necessary_original_wording_required",
              "source_locator_required"
            ]
          }
        }
      ]
    },
    "thread_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_retrieval_task_naturally_closed",
        "rotate_thread_after_close",
        "urge_or_interleave_next_batch"
      ],
      "properties": {
        "current_retrieval_task_naturally_closed": {
          "type": "boolean"
        },
        "rotate_thread_after_close": {
          "type": "boolean"
        },
        "urge_or_interleave_next_batch": {
          "const": false
        }
      }
    },
    "in_scope_iteration_package": {
      "type": "object"
    }
  }
}
